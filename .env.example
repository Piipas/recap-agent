# Copy to `.env` (or `.env.local`) at the repository root. The web app, the worker
# and the Prisma CLI all read it locally. When deploying, set each app's variables on
# its host (see README → "Deploying").

# ─── Database (web + worker) ──────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recap_agent

# ─── Better Auth (web) ────────────────────────────────────────────────────────
# Public base URL of the web app (no trailing slash). OAuth redirect URIs derive from it.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# ─── OAuth apps (see README → "OAuth apps") ───────────────────────────────────
# Each app serves both sign-in and its connection flow (GitHub source / mailbox).
# GitHub: web only. Google and Microsoft: web, and the worker (to refresh mailbox
# tokens when it auto-sends).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── Token encryption (web + worker, same value) ──────────────────────────────
# Encrypts GitHub, mailbox and Groq secrets at rest (AES-256-GCM).
# Exactly 32 bytes, base64-encoded: `openssl rand -base64 32`
# Changing it makes every stored connection unreadable (users must reconnect).
TOKEN_ENCRYPTION_KEY=

# ─── Worker ───────────────────────────────────────────────────────────────────
# Public URL of the web app, for links in notification emails (same as BETTER_AUTH_URL).
APP_URL=http://localhost:3000
# Resend: notifications to the user only; recaps are never sent through it.
RESEND_API_KEY=
# Verified sender in Resend, e.g. "Recap Agent <notifications@yourdomain.com>"
EMAIL_FROM=
# Recaps generated in parallel by one worker process (1–20, default 3).
# WORKER_CONCURRENCY=3

# ─── Tests (optional) ─────────────────────────────────────────────────────────
# Migrated PostgreSQL database for the *.db.test.ts suites. Its data is modified.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recap_agent_test
